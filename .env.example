# === Veritabanı ===
# Host'tan koşan araçlar (alembic, pytest) için localhost; docker compose
# container içinde bu değeri "postgres:5432/support" ile override eder.
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5434/support

# === Groq LLM ===
# https://console.groq.com/keys adresinden ücretsiz alınır (ZORUNLU)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# === Embeddings (yerel sentence-transformers, offline) ===
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# === Reranker (cross-encoder, ilk kullanımda lazy yüklenir, ~2 GB) ===
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# === Langfuse observability (boşsa trace devre dışı, uygulama etkilenmez) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# === Auth (JWT) ===
# Prod'da mutlaka değiştirin
JWT_SECRET=changeme
JWT_ALG=HS256
JWT_EXPIRE_MIN=1440

# === CORS ===
CORS_ORIGINS=["http://localhost:3002"]

# === Test izolasyonu ===
# Host pytest'i bu DB'ye bağlanır; set değilse test temizliği atlanır (guard).
# Not: Bu DB, scripts/init-db.sh ile ilk volume oluşturulurken otomatik açılır;
# mevcut bir kurulumda elle: CREATE DATABASE support_test OWNER support;
TEST_DATABASE_URL=postgresql+asyncpg://support:support@localhost:5434/support_test
TEST_DATABASE_URL_DOCKER=postgresql+asyncpg://support:support@postgres:5432/support_test
